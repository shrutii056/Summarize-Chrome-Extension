{
  "manifest_version": 3,
  "name": "Summarize Assistant",
  "version": "1.0",
  "description": "A Chrome extension that summarizes the content of the current webpage.",
  "permissions": ["activeTab", "storage", "sidePanel", "scripting"],
  "action": {
    "default_title": "Summarize Assistant"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["http://localhost:8080/*", "<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
